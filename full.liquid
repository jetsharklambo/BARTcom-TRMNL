  <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

<div class="layout layout--col gap--small">
  {% if root.schedule.request.trip %}
    {% assign trips = root.schedule.request.trip %}
    <div class="grid grid--cols-3 gap--small">
      <!-- LEFT COLUMN: Summary + Main Trip (spans 2 columns) -->
      <div class="layout layout--col gap--small col--span-2 m--2">
        <!-- Summary Card - 1/3 vertical space -->
        <div class="item bg--white rounded--base mt--4 p--2" style="border: 2px solid #000; flex: 1.5;">
          <div class="content grid grid--cols-12 gap--small">

            <!-- Row 1: Origin -->
            {% if trmnl.plugin_settings.custom_fields_values.show_icons == 'true' %}
            <i class="bi bi-geo-alt-fill value--small col--span-1 self--center"></i>
            <div class="title title--large pt--2 col--span-11 clamp--1">{{ origin_name }}</div>
            {% else %}
            <div class="title title--large pt--2 col--span-12 clamp--1">{{ origin_name }}</div>
            {% endif %}

            <!-- Row 2: Destination -->
            {% if trmnl.plugin_settings.custom_fields_values.show_icons == 'true' %}
            <i class="bi bi-geo-fill value--small self--center col--span-1"></i>
            <div class="title title--large pt--2 col--span-11 clamp--1">{{ destination_name }}</div>
            {% else %}
            <div class="title title--large pt--2 col--span-12 clamp--1">{{ destination_name }}</div>
            {% endif %}

            <!-- Unique Trip Routes - Show 2 fastest -->
            {% assign unique_routes = "" %}
            {% assign unique_count = 0 %}
            {% for trip in trips %}
              {% if unique_count < 2 %}
                {% assign route_key = "" %}
                {% if trip.leg[0] %}
                  {% for leg in trip.leg %}
                    {% assign route_key = route_key | append: leg['@trainHeadStation'] | append: "," %}
                  {% endfor %}
                {% else %}
                  {% assign route_key = trip.leg['@trainHeadStation'] %}
                {% endif %}

                {% unless unique_routes contains route_key %}
                  {% assign unique_routes = unique_routes | append: route_key | append: "|" %}
                  {% assign unique_count = unique_count | plus: 1 %}

                  <!-- Row 3+: Train Routes -->
                  {% if trmnl.plugin_settings.custom_fields_values.show_icons =='true'%}
                  <img class="image image-stroke--small self--center col--span-1" src="data:image/svg+xml;base64,{{ train_svg | base64_encode }}">
                  <div class="flex flex--middle pt--2 col--span-11">
                  {% else %}
                  <div class="flex flex--middle pt--2 col--span-12">
                  {% endif %}
                    <div class="flex flex--wrap gap--small">
                      {% if trip.leg[0] %}
                        {% assign leg_count = 0 %}
                        {% for leg in trip.leg %}
                          {% assign heading_lower = leg['@trainHeadStation'] | downcase %}
                          {% if heading_lower contains 'richmond' %}
                            {% assign abbreviation = 'RICH' %}
                          {% elsif heading_lower contains 'millbrae' %}
                            {% assign abbreviation = 'MLBR' %}
                          {% elsif heading_lower contains 'dublin' %}
                            {% assign abbreviation = 'DUBL' %}
                          {% elsif heading_lower contains 'berryessa' %}
                            {% assign abbreviation = 'BERY' %}
                          {% elsif heading_lower contains 'daly' %}
                            {% assign abbreviation = 'DALY' %}
                          {% elsif heading_lower contains 'antioch' %}
                            {% assign abbreviation = 'ANTC' %}
                          {% elsif heading_lower contains 'pittsburg' %}
                            {% assign abbreviation = 'PITT' %}
                          {% elsif heading_lower contains 'sfo' %}
                            {% assign abbreviation = 'SFIA' %}
                      {% elsif heading_lower contains 'francisco inter' %}
                    {% assign abbreviation = 'SFIA' %}
                      {% elsif heading_lower contains 'oakland air' %}
                  {% assign abbreviation = 'OAKL' %}
                          {% else %}
                            {% assign abbreviation = leg['@trainHeadStation'] %}
                          {% endif %}

                          {% if abbreviation and leg_count < 2 %}
                            
                            <span class="label label--large label--outline">{{ abbreviation }}</span>
                            {% assign leg_count = leg_count | plus: 1 %}
                          {% endif %}
                        {% endfor %}
                      {% else %}
                        {% assign leg = trip.leg %}
                        {% assign heading_lower = leg['@trainHeadStation'] | downcase %}
                        {% if heading_lower contains 'richmond' %}
                          {% assign abbreviation = 'RICH' %}
                        {% elsif heading_lower contains 'millbrae' %}
                          {% assign abbreviation = 'MLBR' %}
                        {% elsif heading_lower contains 'dublin' %}
                          {% assign abbreviation = 'DUBL' %}
                        {% elsif heading_lower contains 'berryessa' %}
                          {% assign abbreviation = 'BERY' %}
                        {% elsif heading_lower contains 'daly' %}
                          {% assign abbreviation = 'DALY' %}
                        {% elsif heading_lower contains 'antioch' %}
                          {% assign abbreviation = 'ANTC' %}
                        {% elsif heading_lower contains 'pittsburg' %}
                          {% assign abbreviation = 'PITT' %}
                        {% elsif heading_lower contains 'sfo' %}
                          {% assign abbreviation = 'SFIA' %}
                        {% elsif heading_lower contains 'francisco inter' %}
                    {% assign abbreviation = 'SFIA' %}    
                            {% elsif heading_lower contains 'oakland air' %}
                  {% assign abbreviation = 'OAKL' %}
                        {% else %}
                          {% assign abbreviation = leg['@trainHeadStation'] %}
                        {% endif %}
                            
                        <span class="label label--large label--filled label--outline">{{ abbreviation }}</span>
                      {% endif %}
                    </div>
                    <span class="label label--filled">{{ trip['@tripTime'] }} min</span>
                  </div>
                {% endunless %}
              {% endif %}
            {% endfor %}

          </div>
        </div>

        <!-- Main Trip Card (First Trip) - 2/3 vertical space -->
        {% assign main_trip = trips[0] %}
        <div class="item bg--black rounded--medium p--2" style="flex: 2;">
          <div class="content flex flex--row gap--medium">

            {% if trmnl.plugin_settings.custom_fields_values.show_icons =='true'%}
            <!-- Icon Column -->
            <div class="flex flex--col gap--medium pt--2 m--2 flex--middle self--center" style="min-width: 20px;">
              <img class="image image-stroke--small" src="data:image/svg+xml;base64,{{ train_svg | base64_encode }}">
              <i class="bi bi-geo-alt-fill text--gray-40 value--large"></i>
              <i class="bi bi-geo-fill text--gray-40 value--large"></i>
            </div>
            {% endif %}

            <!-- Data Column -->
            {% if trmnl.plugin_settings.custom_fields_values.show_icons =='true'%}
            <div class="flex flex--col flex--left pl--2 pt--4 gap--medium grow">
               {% else %}
              <div class="flex flex--col flex--left pl--2 pt--4 gap--small grow">
                 {% endif %}
              <!-- Train Line Badges -->
              <div class="flex flex--wrap gap--small">
                {% if main_trip.leg[0] %}
                  {% assign leg_count = 0 %}
                  {% for leg in main_trip.leg %}
                    {% assign heading_lower = leg['@trainHeadStation'] | downcase %}
                    {% if heading_lower contains 'richmond' %}
                      {% assign abbreviation = 'RICH' %}
                    {% elsif heading_lower contains 'millbrae' %}
                      {% assign abbreviation = 'MLBR' %}
                    {% elsif heading_lower contains 'dublin' %}
                      {% assign abbreviation = 'DUBL' %}
                    {% elsif heading_lower contains 'berryessa' %}
                      {% assign abbreviation = 'BERY' %}
                    {% elsif heading_lower contains 'daly' %}
                      {% assign abbreviation = 'DALY' %}
                    {% elsif heading_lower contains 'antioch' %}
                      {% assign abbreviation = 'ANTC' %}
                    {% elsif heading_lower contains 'pittsburg' %}
                      {% assign abbreviation = 'PITT' %}
                    {% elsif heading_lower contains 'sfo' %}
                      {% assign abbreviation = 'SFIA' %}
                    {% elsif heading_lower contains 'francisco inter' %}
                      {% assign abbreviation = 'SFIA' %}
                    {% elsif heading_lower contains 'oakland air' %}
                      {% assign abbreviation = 'OAKL' %}
                    {% else %}
                      {% assign abbreviation = leg['@trainHeadStation'] %}
                    {% endif %}

                    {% if abbreviation and leg_count < 2 %}
                      <span class="label label--xxlarge bg--white rounded--small p--1">
                        {{ abbreviation }}
                      </span>
                      {% assign leg_count = leg_count | plus: 1 %}
                    {% endif %}
                  {% endfor %}
                {% else %}
                  {% assign leg = main_trip.leg %}
                  {% assign heading_lower = leg['@trainHeadStation'] | downcase %}
                  {% if heading_lower contains 'richmond' %}
                    {% assign abbreviation = 'RICH' %}
                  {% elsif heading_lower contains 'millbrae' %}
                    {% assign abbreviation = 'MLBR' %}
                  {% elsif heading_lower contains 'dublin' %}
                    {% assign abbreviation = 'DUBL' %}
                  {% elsif heading_lower contains 'berryessa' %}
                    {% assign abbreviation = 'BERY' %}
                  {% elsif heading_lower contains 'daly' %}
                    {% assign abbreviation = 'DALY' %}
                  {% elsif heading_lower contains 'antioch' %}
                    {% assign abbreviation = 'ANTC' %}
                  {% elsif heading_lower contains 'pittsburg' %}
                    {% assign abbreviation = 'PITT' %}
                  {% elsif heading_lower contains 'sfo' %}
                    {% assign abbreviation = 'SFIA' %}
                  {% elsif heading_lower contains 'francisco inter' %}
                    {% assign abbreviation = 'SFIA' %}
                  {% elsif heading_lower contains 'oakland air' %}
                    {% assign abbreviation = 'OAKL' %}
                  {% else %}
                    {% assign abbreviation = leg['@trainHeadStation'] %}
                  {% endif %}
                  <span class="label label--large bg--white rounded--small p--1">
                    {{ abbreviation }}
                  </span>
                {% endif %}
              </div>
{% if trmnl.plugin_settings.custom_fields_values.show_icons == 'true' %}
              <div class="value value--xlarge text--white">{{ main_trip['@origTimeMin'] }}</div>
               {% else %}
                <div class="value value--xxlarge text--white">{{ main_trip['@origTimeMin'] }}</div>
               {% endif %}
              <div class="value value--medium text--gray-60">{{ main_trip['@destTimeMin'] }}</div>
            </div>

          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: Three Smaller Trip Cards (spans 1 column) -->
      <div class="layout layout--col gap--small pt--6 stretch-y">
        {% for trip in trips offset:1 limit:3 %}
          <div class="item bg--black rounded--medium p--2" style="flex: 1;">
            <div class="content flex flex--row gap--small">

              {% if trmnl.plugin_settings.custom_fields_values.show_icons =='true'%}
              <!-- Icon Column -->
              <div class="flex flex--col gap--medium pt--2 m--1 flex--center-y" style="min-width: 25px;">
                <img class="image image-stroke--small" src="data:image/svg+xml;base64,{{ train_svg | base64_encode }}">
                <i class="bi bi-geo-alt-fill text--gray-40 value--small"></i>
                <i class="bi bi-geo-fill text--gray-40 value--small"></i>
              </div>
              {% endif %}

              <!-- Data Column -->
              <div class="flex flex--col flex--left pl--2 pt--2 gap--small flex--center-y">
                <!-- Train Line Badges -->
                <div class="flex flex--wrap gap--small">
                  {% if trip.leg[0] %}
                    {% assign leg_count = 0 %}
                    {% for leg in trip.leg %}
                      {% assign heading_lower = leg['@trainHeadStation'] | downcase %}
                      {% if heading_lower contains 'richmond' %}
                        {% assign abbreviation = 'RICH' %}
                      {% elsif heading_lower contains 'millbrae' %}
                        {% assign abbreviation = 'MLBR' %}
                      {% elsif heading_lower contains 'dublin' %}
                        {% assign abbreviation = 'DUBL' %}
                      {% elsif heading_lower contains 'berryessa' %}
                        {% assign abbreviation = 'BERY' %}
                      {% elsif heading_lower contains 'daly' %}
                        {% assign abbreviation = 'DALY' %}
                      {% elsif heading_lower contains 'antioch' %}
                        {% assign abbreviation = 'ANTC' %}
                      {% elsif heading_lower contains 'pittsburg' %}
                        {% assign abbreviation = 'PITT' %}
                      {% elsif heading_lower contains 'sfo' %}
                        {% assign abbreviation = 'SFIA' %}
                      {% elsif heading_lower contains 'francisco inter' %}
                        {% assign abbreviation = 'SFIA' %}
                      {% elsif heading_lower contains 'oakland air' %}
                        {% assign abbreviation = 'OAKL' %}
                      {% else %}
                        {% assign abbreviation = leg['@trainHeadStation'] %}
                      {% endif %}

                      {% if abbreviation and leg_count < 2 %}
                        <span class="label bg--white label--large rounded--small p--1">
                          {{ abbreviation }}
                        </span>
                        {% assign leg_count = leg_count | plus: 1 %}
                      {% endif %}
                    {% endfor %}
                  {% else %}
                    {% assign leg = trip.leg %}
                    {% assign heading_lower = leg['@trainHeadStation'] | downcase %}
                    {% if heading_lower contains 'richmond' %}
                      {% assign abbreviation = 'RICH' %}
                    {% elsif heading_lower contains 'millbrae' %}
                      {% assign abbreviation = 'MLBR' %}
                    {% elsif heading_lower contains 'dublin' %}
                      {% assign abbreviation = 'DUBL' %}
                    {% elsif heading_lower contains 'berryessa' %}
                      {% assign abbreviation = 'BERY' %}
                    {% elsif heading_lower contains 'daly' %}
                      {% assign abbreviation = 'DALY' %}
                    {% elsif heading_lower contains 'antioch' %}
                      {% assign abbreviation = 'ANTC' %}
                    {% elsif heading_lower contains 'pittsburg' %}
                      {% assign abbreviation = 'PITT' %}
                    {% elsif heading_lower contains 'sfo' %}
                      {% assign abbreviation = 'SFIA' %}
                    {% elsif heading_lower contains 'francisco inter' %}
                      {% assign abbreviation = 'SFIA' %}
                    {% elsif heading_lower contains 'oakland air' %}
                      {% assign abbreviation = 'OAKL' %}
                    {% else %}
                      {% assign abbreviation = leg['@trainHeadStation'] %}
                    {% endif %}
                    <span class="label bg--white rounded--small p--1">
                      {{ abbreviation }}
                    </span>
                  {% endif %}
                </div>

                <div class="value value--medium text--white">{{ trip['@origTimeMin'] }}</div>
                <div class="title text--gray-60 pl--1 pb--2">{{ trip['@destTimeMin'] }}</div>
              </div>

            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% else %}
    <!-- Error State: No data -->
    <div class="item">
      <div class="content layout--col gap--small">
        <div class="value value--xlarge">⚠️</div>
        <div class="label label--small">No schedule available</div>
        {% if root.message.error %}
          <div class="label label--small">{{ root.message.error.text }}</div>
        {% endif %}
      </div>
    </div>
  {% endif %}

  <div class="footer">
    <div class="divider"></div>
    <div class="label label--small">Real-time BART schedule</div>
  </div>
</div>